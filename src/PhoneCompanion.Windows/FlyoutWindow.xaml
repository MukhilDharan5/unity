<Window x:Class="PhoneCompanion.Windows.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone Companion" Width="368" SizeToContent="Height" MaxHeight="640"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" FontSize="13"
        Foreground="{DynamicResource PrimaryText}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Deactivated="OnDeactivated" PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="UiResources.xaml" /></ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style x:Key="MediaButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Icon}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="26"
                                BorderBrush="{DynamicResource Accent}" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentSurface}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.32" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TogglePill" TargetType="Button">
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{DynamicResource SubtleBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" CornerRadius="14" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSurface}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Opacity" Value="0.78" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /><Setter Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Pill" Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="8" Background="{DynamicResource WindowBackground}" CornerRadius="18"
            BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28" Color="#000000" />
        </Border.Effect>
        <ScrollViewer Style="{StaticResource CleanScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="23,22,23,19">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="48" CornerRadius="12" Background="{DynamicResource AccentSurface}"
                            Margin="0,1,12,0" VerticalAlignment="Top">
                        <Viewbox Width="17" Height="27">
                            <Canvas Width="20" Height="32">
                                <Path Stroke="{DynamicResource Icon}" StrokeThickness="1.8"
                                      Data="M 5,1 L 15,1 Q 19,1 19,5 L 19,27 Q 19,31 15,31 L 5,31 Q 1,31 1,27 L 1,5 Q 1,1 5,1 Z M 7,5 L 13,5 M 8,27 L 12,27" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Phone" FontSize="21" FontWeight="SemiBold" Margin="0,-3,0,3" />
                        <TextBlock Text="{Binding BatteryText}" Foreground="{DynamicResource SecondaryText}" FontSize="12" />
                    </StackPanel>
                    <Border Grid.Column="2" VerticalAlignment="Top" CornerRadius="9" Padding="8,4" Margin="0,1,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SubtleBackground}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentSurface}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}" AutomationProperties.LiveSetting="Polite" />
                    </Border>
                </Grid>
                <TextBlock Text="{Binding CellularText}" Foreground="{DynamicResource SecondaryText}"
                           FontSize="12" Margin="0,13,0,0" />

                <!-- Keep the flyout compact: the player exists only while the phone reports active playback. -->
                <Border x:Name="MediaCard" Visibility="{Binding HasMedia, Converter={StaticResource BooleanToVisibility}}"
                        CornerRadius="13" Background="{DynamicResource SurfaceBackground}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="19,17,19,14" Margin="0,19,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,13">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Source}" Foreground="{DynamicResource SecondaryText}" FontSize="11"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,-3,0,0">
                                <TextBlock Text="{Binding PlaybackStateText}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentInk}" VerticalAlignment="Center"
                                           AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="♫" FontSize="15" Foreground="{DynamicResource AccentInk}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{Binding Artist}" Foreground="{DynamicResource SecondaryText}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Artist}" Margin="0,4,0,0" FontSize="12" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,21,0,0">
                            <Button Style="{StaticResource MediaButton}" Command="{Binding Previous}" ToolTip="Previous track"
                                    AutomationProperties.Name="Previous track" Margin="0,4,18,0">
                                <Path Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource Icon}"
                                      Data="M 3,4 L 6,4 L 6,20 L 3,20 Z M 20,4 L 8,12 L 20,20 Z" />
                            </Button>
                            <Button Style="{StaticResource MediaButton}" Command="{Binding PlayPause}" Width="52" Height="52"
                                    Background="{DynamicResource Accent}" ToolTip="{Binding PlaybackLabel}"
                                    AutomationProperties.Name="{Binding PlaybackLabel}">
                                <Path Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource AccentText}" Data="{Binding PlaybackPath}" />
                            </Button>
                            <Button Style="{StaticResource MediaButton}" Command="{Binding Next}" ToolTip="Next track"
                                    AutomationProperties.Name="Next track" Margin="18,4,0,0">
                                <Path Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource Icon}"
                                      Data="M 18,4 L 21,4 L 21,20 L 18,20 Z M 4,4 L 16,12 L 4,20 Z" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Margin="1,21,1,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Path Width="15" Height="15" Stretch="Uniform" Stroke="{DynamicResource Icon}" StrokeThickness="1.5"
                          Data="M 17,11 A 8,8 0 1 1 9,3 A 6,6 0 0 0 17,11 Z" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="1" Text="Do Not Disturb" />
                    <TextBlock Grid.Column="2" Text="{Binding Dnd}" Foreground="{DynamicResource SecondaryText}"
                               AutomationProperties.Name="Do Not Disturb state" AutomationProperties.LiveSetting="Polite" />
                </Grid>
                <Grid Margin="28,12,1,0" Visibility="{Binding CanControlDndRule, Converter={StaticResource BooleanToVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Companion DND" />
                        <TextBlock Text="Controls only this app’s phone rule" Foreground="{DynamicResource SecondaryText}" FontSize="9" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource TogglePill}" Content="{Binding DndRuleState}"
                            Tag="{Binding IsDndRuleActive}" Command="{Binding ToggleDndRule}"
                            ToolTip="{Binding DndRuleAction}" AutomationProperties.Name="{Binding DndRuleAction}" />
                </Grid>
                <Border Height="1" Background="{DynamicResource Border}" Margin="0,14,0,14" />
                <Grid Margin="1,0,1,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Path Width="17" Height="16" Stretch="Uniform" Stroke="{DynamicResource Icon}" StrokeThickness="1.5"
                          Data="M 2,8 L 6,8 L 11,4 L 11,20 L 6,16 L 2,16 Z M 15,8 Q 19,12 15,16 M 18,5 Q 25,12 18,19" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="1" Text="Sound" />
                    <TextBlock Grid.Column="2" Text="{Binding Sound}" Foreground="{DynamicResource SecondaryText}"
                               AutomationProperties.Name="Phone sound mode" AutomationProperties.LiveSetting="Polite" />
                </Grid>
                <Border Height="1" Background="{DynamicResource Border}" Margin="0,14,0,14" />
                <Grid Margin="1,0,1,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource Icon}" StrokeThickness="1.5"
                          Data="M 7,5 L 17,5 Q 20,5 20,8 L 20,18 Q 20,21 17,21 L 7,21 Q 4,21 4,18 L 4,8 Q 4,5 7,5 Z M 9,5 L 9,2 L 15,2 L 15,5 M 8,10 L 16,10 M 8,14 L 16,14 M 8,18 L 13,18"
                          HorizontalAlignment="Left" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Clipboard sync" />
                        <TextBlock Text="New text only · No history" Foreground="{DynamicResource SecondaryText}" FontSize="9" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource TogglePill}" Content="{Binding ClipboardStatus}"
                            Tag="{Binding ClipboardEnabled}" Command="{Binding ToggleClipboard}"
                            ToolTip="{Binding ClipboardAction}" AutomationProperties.Name="{Binding ClipboardAction}" />
                </Grid>
                <StackPanel Visibility="{Binding HasPhoneBrightness, Converter={StaticResource BooleanToVisibility}}">
                    <Border Height="1" Background="{DynamicResource Border}" Margin="0,14,0,14" />
                    <Grid Margin="1,0,1,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE706;" Style="{StaticResource Glyph}" FontSize="16" HorizontalAlignment="Left" />
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="Phone brightness" />
                            <TextBlock Text="{Binding AmbientLightText}" Foreground="{DynamicResource SecondaryText}" FontSize="9" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PhoneBrightnessText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Style="{StaticResource TogglePill}" Content="{Binding PhoneAdaptiveText}"
                                    Command="{Binding TogglePhoneAdaptive}" IsEnabled="{Binding CanControlPhoneBrightness}"
                                    AutomationProperties.Name="Toggle adaptive phone brightness" />
                        </StackPanel>
                    </Grid>
                    <Slider Minimum="1" Maximum="100" TickFrequency="1" IsMoveToPointEnabled="True" Margin="28,9,1,0"
                            Value="{Binding PhoneBrightnessLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding CanControlPhoneBrightness}" AutomationProperties.Name="Phone brightness" />
                </StackPanel>
                <Border Height="1" Background="{DynamicResource Border}" Margin="0,14,0,14" />
                <Grid Margin="1,0,1,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE706;" Style="{StaticResource Glyph}" FontSize="16" HorizontalAlignment="Left" />
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Laptop auto brightness" />
                        <TextBlock Text="{Binding LaptopAdaptiveStatus}" Foreground="{DynamicResource SecondaryText}" FontSize="9" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource TogglePill}" Content="{Binding LaptopAdaptiveState}"
                            Tag="{Binding IsLaptopAdaptive}" Command="{Binding ToggleLaptopAdaptive}" IsEnabled="{Binding CanUseLaptopAdaptive}"
                            ToolTip="{Binding LaptopAdaptiveAction}" AutomationProperties.Name="{Binding LaptopAdaptiveAction}" />
                </Grid>
                <TextBlock Text="{Binding Footer}" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource SecondaryText}" FontSize="10" Margin="0,24,0,0"
                           AutomationProperties.LiveSetting="Polite" />
                <Button Style="{StaticResource PrimaryButton}" Content="Open phone" Height="34" MinHeight="0" Padding="12,7" Margin="0,12,0,0"
                        Command="{Binding OpenPhone}" AutomationProperties.Name="Open phone screen" />
                <Button Style="{StaticResource TextButton}" Content="Connect phone" Height="30" MinHeight="0" Padding="12,6" Margin="0,4,0,0" Click="OnConnectPhone"
                        AutomationProperties.Name="Connect or change phone" />
                <Button Style="{StaticResource TextButton}" Content="Open Unity Connect" FontSize="10" Height="26" MinHeight="0" Padding="8,4" Margin="0,4,0,0" Click="OnOpenDesktop" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
