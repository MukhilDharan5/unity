<Application x:Class="PhoneCompanion.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Light defaults prevent an unstyled frame before SystemThemeService applies Windows' theme. -->
        <SolidColorBrush x:Key="WindowBackground" Color="#FFF3F3F3" />
        <SolidColorBrush x:Key="SurfaceBackground" Color="#FFF9F9F9" />
        <SolidColorBrush x:Key="SubtleBackground" Color="#0A000000" />
        <SolidColorBrush x:Key="PrimaryText" Color="#FF1A1A1A" />
        <SolidColorBrush x:Key="SecondaryText" Color="#FF5D5D5D" />
        <SolidColorBrush x:Key="Accent" Color="#FF0067C0" />
        <SolidColorBrush x:Key="AccentText" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="AccentSurface" Color="#1F0067C0" />
        <SolidColorBrush x:Key="Border" Color="#16000000" />
        <SolidColorBrush x:Key="CardStroke" Color="#19000000" />
        <SolidColorBrush x:Key="ControlStroke" Color="#26000000" />
        <SolidColorBrush x:Key="ControlFill" Color="#B3FFFFFF" />
        <SolidColorBrush x:Key="ControlHover" Color="#0F000000" />
        <SolidColorBrush x:Key="ControlPressed" Color="#18000000" />
        <SolidColorBrush x:Key="Icon" Color="#FF202020" />
        <SolidColorBrush x:Key="Disabled" Color="#FF9A9A9A" />
        <SolidColorBrush x:Key="Shadow" Color="#FF000000" />
        <SolidColorBrush x:Key="PageBackground" Color="#FFF9F9F9" />
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SidebarBackground" Color="#FFF3F3F3" />
        <SolidColorBrush x:Key="AccentInk" Color="#FF005A9E" />
        <SolidColorBrush x:Key="SwitchTrack" Color="#33000000" />
        <SolidColorBrush x:Key="NavigationSelected" Color="#0F000000" />
    </Application.Resources>
</Application>
