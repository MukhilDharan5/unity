<Window x:Class="PhoneCompanion.Windows.PairingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect your phone" Icon="{DynamicResource AppIcon}" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}"
        FontFamily="Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources><ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="UiResources.xaml" /></ResourceDictionary.MergedDictionaries>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SubtleBackground}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CaretBrush" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="Input" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost" /></Border>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Input" Property="BorderBrush" Value="{DynamicResource AccentInk}" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Input" Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </ResourceDictionary></Window.Resources>
    <Grid Background="{DynamicResource WindowBackground}">
        <StackPanel Margin="32,28,32,26">
            <Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource AccentSurface}" HorizontalAlignment="Left" Margin="0,0,0,20"><TextBlock Text="&#xE71B;" Style="{StaticResource Glyph}" FontSize="22" HorizontalAlignment="Center" /></Border>
            <TextBlock Text="Connect your phone" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="Open Unity Connect on your phone and tap Start pairing." Style="{StaticResource Caption}" Margin="0,8,0,26" />
            <StackPanel x:Name="ConnectPanel">
                <TextBlock Text="Phone Wi-Fi address" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,9" />
                <TextBox x:Name="Endpoint" Height="42" Padding="12,9" FontSize="14" VerticalContentAlignment="Center" AutomationProperties.Name="Phone Wi-Fi address" />
                <TextBlock Text="Use the address shown in the phone app." Style="{StaticResource Caption}" FontSize="10" Margin="1,7,0,16" />
                <Button x:Name="WifiButton" Style="{StaticResource PrimaryButton}" Content="Connect over Wi-Fi" Height="42" Click="OnWifi" />
                <Grid Margin="0,19"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Height="1" Background="{DynamicResource Border}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="or" Style="{StaticResource Caption}" FontSize="10" Margin="14,0" /><Border Grid.Column="2" Height="1" Background="{DynamicResource Border}" VerticalAlignment="Center" /></Grid>
                <Button x:Name="BluetoothButton" Style="{StaticResource ActionButton}" Height="42" Click="OnBluetooth"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="Find with Bluetooth" /></StackPanel></Button>
            </StackPanel>
            <StackPanel x:Name="CodePanel" Visibility="Collapsed">
                <Border Style="{StaticResource Card}" Background="{DynamicResource SurfaceBackground}" Padding="18,24" Margin="0,0,0,18"><StackPanel>
                    <TextBlock Text="Confirm on both devices" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock x:Name="Code" FontFamily="Consolas" FontSize="42" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,8" />
                    <TextBlock Text="Both screens should show the same code." Style="{StaticResource Caption}" FontSize="10" TextAlignment="Center" />
                </StackPanel></Border>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Style="{StaticResource ActionButton}" Content="Cancel" Click="OnDecline" /><Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Codes match" Click="OnApprove" /></Grid>
            </StackPanel>
            <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="0,18,0,0" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="ForgetButton" Style="{StaticResource TextButton}" Content="Forget paired phone" Margin="0,12,0,0" Visibility="Collapsed" Click="OnForget" />
        </StackPanel>
    </Grid>
</Window>
